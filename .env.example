# .env.example — plantilla de variables de entorno (SIN SECRETOS REALES)
# Copia a `.env` y ajusta los valores. `.env` está en .gitignore: NO lo commitees.

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=sandbox

# --- URLs de conexión (consumidas por api y worker) -----------------------
# El host `db` / `redis` es el nombre de servicio en docker-compose.
DATABASE_URL=postgresql+asyncpg://sandbox:change_me_in_local_env@db:5432/sandbox
REDIS_URL=redis://redis:6379/0
