# .env.example — plantilla de variables de entorno (SIN SECRETOS REALES)
# Copia a `.env` y ajusta los valores. `.env` está en .gitignore: NO lo commitees.

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=sandbox

# --- URLs de conexión (consumidas por api y worker) -----------------------
# Los hosts `db` / `valkey` son los nombres de servicio en docker-compose.
# Nota: el broker es Valkey 8 (ADR-011), pero el protocolo sigue siendo redis://.
DATABASE_URL=postgresql+asyncpg://sandbox:change_me_in_local_env@db:5432/sandbox
REDIS_URL=redis://valkey:6379/0

# --- Celery (broker de tareas + backend de resultados) --------------------
# Índices de DB distintos en el mismo Valkey: 0 = cola, 1 = resultados.
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1

# --- Emulación / worker (CP-3) --------------------------------------------
# Timeout (s) de una detonación en QEMU.
EMULATION_TIMEOUT=180
# Ruta del repo EN EL HOST para el wiring Docker-out-of-Docker (ADR-017). Déjala vacía:
# el worker la autodescubre inspeccionando su bind /project. Solo defínela si tu setup
# impide esa introspección (p.ej. hostname del contenedor forzado).
HOST_PROJECT_DIR=
