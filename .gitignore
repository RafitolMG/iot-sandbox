# ─────────────────────────────────────────────────────────────────────────
# IoT Malware Dynamic Analysis Sandbox — .gitignore
# ─────────────────────────────────────────────────────────────────────────

# --- Secretos / entorno ---------------------------------------------------
.env
.env.*
!.env.example

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Node / Frontend ------------------------------------------------------
node_modules/
frontend/dist/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- MUESTRAS DE MALWARE Y ARTEFACTOS DE ANÁLISIS (nunca al repo) ----------
samples/
artifacts/
*.pcap
*.pcapng
*.sample
*.malware
strace.log
fs_events.log

# --- Imágenes de emulación (kernels / rootfs / discos; se generan, pesan) --
*.img
*.qcow2
*.qcow
*.raw
*.ext2
*.ext4
*.cpio
*.cpio.gz
*.squashfs
*.dtb
zImage
bzImage
vmlinux
vmlinuz*
initramfs*
emulation/**/output/
emulation/**/downloads/
emulation/**/dl/
# Árbol de build por ISA (Buildroot, imágenes, artefactos, sample-overlay; se generan)
emulation/*/_build/
# Cache de descargas de Buildroot COMPARTIDA entre ISAs
emulation/_dl/

# --- Docker / build -------------------------------------------------------
*.pid

# --- Logs -----------------------------------------------------------------
*.log

# --- SO / editores --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Memoria del TFM ------------------------------------------------------
# Borradores de la memoria (.docx/.md) y comentarios del tutor. El agente SÍ debe
# leer esta carpeta como contexto, pero queda FUERA de git a propósito.
MEMORIA/
