# ─────────────────────────────────────────────────────────────────────────
# IoT Malware Dynamic Analysis Sandbox — .gitignore
# ─────────────────────────────────────────────────────────────────────────

# --- Secretos / entorno ---------------------------------------------------
.env
.env.*
!.env.example

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Node / Frontend ------------------------------------------------------
node_modules/
frontend/dist/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- MUESTRAS DE MALWARE Y ARTEFACTOS DE ANÁLISIS (nunca al repo) ----------
samples/
artifacts/
*.pcap
*.pcapng
*.sample
*.malware
strace.log
fs_events.log

# --- Imágenes de emulación (kernels / rootfs / discos; se generan, pesan) --
*.img
*.qcow2
*.qcow
*.raw
*.ext2
*.ext4
*.cpio
*.cpio.gz
*.squashfs
*.dtb
zImage
bzImage
vmlinuz*
initramfs*
emulation/**/output/
emulation/**/downloads/
emulation/**/dl/
# Árbol de build de la sandbox ARM (Buildroot, imágenes, artefactos; se generan)
emulation/arm/_build/
# Binario de prueba compilado que se inyecta en el overlay del rootfs
emulation/arm/overlay/opt/sample/test_sample

# --- Docker / build -------------------------------------------------------
*.pid

# --- Logs -----------------------------------------------------------------
*.log

# --- SO / editores --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
