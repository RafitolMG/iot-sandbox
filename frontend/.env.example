# frontend/.env.example — variables de entorno de la SPA (Vite).
# Copiar a `.env` para desarrollo local si se desea cambiar el destino.

# Base de la API vista por el navegador. Por defecto `/api` (ruta relativa al mismo origen),
# que el proxy de Vite (dev) o nginx (Docker) reenvía al backend FastAPI.
VITE_API_BASE=/api

# Solo para `npm run dev` en el host: origen real del backend al que el dev-server de Vite
# reenvía las peticiones `/api`. Por defecto http://localhost:8000.
VITE_DEV_API_TARGET=http://localhost:8000
