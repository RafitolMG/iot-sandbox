# profiles/arm.env — Perfil de emulación ARM (PRIMER entry del registro, CP-6 / ADR-020).
# ===========================================================================================
# ISA existente del MVP (CP-2, ADR-016): ARM Cortex-A9 / ARMv7-A hard-float sobre vexpress-a9.
# Convertido en el primer entry del registro de perfiles SIN cambiar máquina/kernel/rootfs:
# el kernel+rootfs ya construidos en emulation/arm/_build/images/ siguen siendo válidos.
#
# Sourced (POSIX/bash) por emulation/build_rootfs.sh y emulation/run_emulation.sh.

P_ARCH="arm"
P_DESC="ARM Cortex-A9 / ARMv7-A hard-float (vexpress-a9)"

# --- Buildroot / toolchain de compilación del binario de prueba (estático) ---
P_BR_DEFCONFIG="qemu_arm_vexpress_defconfig"
P_CROSS_CC="arm-linux-gnueabihf-gcc"
P_CFLAGS="-march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard"

# --- QEMU full-system ---
P_QEMU_BIN="qemu-system-arm"
P_QEMU_MACHINE="vexpress-a9"
P_QEMU_CPU=""
P_QEMU_MEM="256"

# --- Kernel / disco / arranque del invitado ---
P_KERNEL_IMAGE="zImage"                 # output/images/zImage
P_DTB="vexpress-v2p-ca9.dtb"            # ARM necesita DTB; el resto de ISAs no
P_DISK_IF="sd"                          # tarjeta SD -> /dev/mmcblk0
P_ROOT_DEV="/dev/mmcblk0"
P_CONSOLE="ttyAMA0,115200"
P_NIC_MODEL="lan9118"
P_ROOTFS_RESIZE="256M"                  # la SD de vexpress-a9 exige tamaño potencia de 2

# --- Autodetección de ISA por cabecera ELF (backend/app/archdetect.py) ---
P_ELF_MACHINE="40"                      # EM_ARM
P_ELF_DATA="1"                          # ELFDATA2LSB (little-endian)
