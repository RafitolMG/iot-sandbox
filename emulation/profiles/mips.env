# profiles/mips.env — Perfil de emulación MIPS big-endian (CP-6 / ADR-020).
# ===========================================================================================
# 2ª ISA dominante en IoT. MIPS32r2 BIG-ENDIAN sobre la placa QEMU `malta`.
# Par máquina/kernel/rootfs tomado del readme oficial de Buildroot
# (board/qemu/mips32r2-malta): vmlinux + rootfs.ext2 (IDE -> /dev/sda vía libata) + pcnet.
#
# Sourced (POSIX/bash) por emulation/build_rootfs.sh y emulation/run_emulation.sh.

P_ARCH="mips"
P_DESC="MIPS32r2 big-endian (malta)"

# --- Buildroot / toolchain de compilación del binario de prueba (estático) ---
P_BR_DEFCONFIG="qemu_mips32r2_malta_defconfig"
P_CROSS_CC="mips-linux-gnu-gcc"
P_CFLAGS="-march=mips32r2 -mabi=32 -EB"

# --- QEMU full-system ---
P_QEMU_BIN="qemu-system-mips"
P_QEMU_MACHINE="malta"
P_QEMU_CPU=""
P_QEMU_MEM="256"

# --- Kernel / disco / arranque del invitado ---
P_KERNEL_IMAGE="vmlinux"                # Malta arranca un vmlinux ELF con -kernel
P_DTB=""                                # Malta no usa DTB
P_DISK_IF="ide"                         # PIIX4 IDE -> libata -> /dev/sda
P_ROOT_DEV="/dev/sda"
P_CONSOLE="ttyS0,115200"                # UART 16550 de Malta; -nographic la saca por stdio
P_NIC_MODEL="pcnet"
P_ROOTFS_RESIZE=""                      # sin requisito de tamaño potencia de 2

# --- Autodetección de ISA por cabecera ELF (backend/app/archdetect.py) ---
P_ELF_MACHINE="8"                       # EM_MIPS
P_ELF_DATA="2"                          # ELFDATA2MSB (big-endian) -> mips
