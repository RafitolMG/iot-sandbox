# profiles/mipsel.env — Perfil de emulación MIPS little-endian (CP-6 / ADR-020).
# ===========================================================================================
# MIPS32r2 LITTLE-ENDIAN sobre la placa QEMU `malta`. Idéntico a mips salvo endianness:
# defconfig `el`, toolchain mipsel, qemu-system-mipsel, y EM_MIPS + ELFDATA2LSB en la
# autodetección. Par máquina/kernel del readme de Buildroot (board/qemu/mips32r2el-malta).
#
# Sourced (POSIX/bash) por emulation/build_rootfs.sh y emulation/run_emulation.sh.

P_ARCH="mipsel"
P_DESC="MIPS32r2 little-endian (malta)"

# --- Buildroot / toolchain de compilación del binario de prueba (estático) ---
P_BR_DEFCONFIG="qemu_mips32r2el_malta_defconfig"
P_CROSS_CC="mipsel-linux-gnu-gcc"
P_CFLAGS="-march=mips32r2 -mabi=32 -EL"

# --- QEMU full-system ---
P_QEMU_BIN="qemu-system-mipsel"
P_QEMU_MACHINE="malta"
P_QEMU_CPU=""
P_QEMU_MEM="256"

# --- Kernel / disco / arranque del invitado ---
P_KERNEL_IMAGE="vmlinux"
P_DTB=""
P_DISK_IF="ide"                         # PIIX4 IDE -> libata -> /dev/sda
P_ROOT_DEV="/dev/sda"
P_CONSOLE="ttyS0,115200"
P_NIC_MODEL="pcnet"
P_ROOTFS_RESIZE=""

# --- Autodetección de ISA por cabecera ELF (backend/app/archdetect.py) ---
P_ELF_MACHINE="8"                       # EM_MIPS
P_ELF_DATA="1"                          # ELFDATA2LSB (little-endian) -> mipsel
