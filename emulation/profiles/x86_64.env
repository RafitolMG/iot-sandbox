# profiles/x86_64.env — Perfil de emulación x86-64 (CP-6 / ADR-020).
# ===========================================================================================
# ISA de servidores/routers x86 y de contraste con las ISAs empotradas. x86-64 sobre la
# máquina QEMU `pc`. Par máquina/kernel/rootfs del readme oficial de Buildroot
# (board/qemu/x86_64): bzImage + rootfs.ext2 (virtio-blk -> /dev/vda) + virtio-net.
# El binario de prueba se compila con el gcc NATIVO del contenedor de build (x86-64).
#
# Sourced (POSIX/bash) por emulation/build_rootfs.sh y emulation/run_emulation.sh.

P_ARCH="x86_64"
P_DESC="x86-64 (máquina pc, virtio)"

# --- Buildroot / toolchain de compilación del binario de prueba (estático) ---
P_BR_DEFCONFIG="qemu_x86_64_defconfig"
P_CROSS_CC="x86_64-linux-gnu-gcc"       # nativo en el contenedor de build (Debian x86-64)
P_CFLAGS=""

# --- QEMU full-system ---
P_QEMU_BIN="qemu-system-x86_64"
P_QEMU_MACHINE="pc"
P_QEMU_CPU=""
P_QEMU_MEM="512"

# --- Kernel / disco / arranque del invitado ---
P_KERNEL_IMAGE="bzImage"
P_DTB=""
P_DISK_IF="virtio"                      # virtio-blk-pci -> /dev/vda
P_ROOT_DEV="/dev/vda"
P_CONSOLE="ttyS0,115200"
P_NIC_MODEL="virtio"
P_ROOTFS_RESIZE=""

# --- Autodetección de ISA por cabecera ELF (backend/app/archdetect.py) ---
P_ELF_MACHINE="62"                      # EM_X86_64
P_ELF_DATA="1"                          # ELFDATA2LSB (little-endian)
